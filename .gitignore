# Secrets — never committed
.env
.env.*
!.env.example
supabase/.env
*.key
*.pem
*api*key*
*.env.txt

# Configuration d'outillage MCP — pointe une cible de données, jamais committée.
# En litige avec ADR-001 (« jamais Supabase Cloud ») : cf. STATE.md, décision
# humaine en attente. Ignorer ce fichier ne le débranche pas — ce n'est qu'un
# garde-fou contre un `git add -A` distrait.
.mcp.json

# Backups & volumes
backups/
volumes/

# Audio — must never exist on disk (ADR-009), but guard the repo anyway
*.webm
*.wav
*.ogg

# Node / build
node_modules/
.next/
dist/
build/
*.log
npm-debug.log*
*.tsbuildinfo
next-env.d.ts

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Supabase local dev
supabase/.temp/

# Rapports de mesure au navigateur (V2). Un ARTEFACT DE MESURE N'EST PAS UN
# LIVRABLE : il ne vaut que pour l'arbre, le HEAD et l'heure où il a été pris,
# et `checkpoint-v2.sh` le refuse dès que l'un des trois a bougé. Committé, il
# ferait croire à un vert qui voyage avec le dépôt — exactement le « souvenir »
# que ce mécanisme existe pour empêcher.
scripts/.mesures/

# Sortie de compilation des passes d'évaluation (`eval-jarvis-*.mjs`).
# Les modules de `src/services` y sont recompilés en CommonJS pour être chargés
# par Node sans Next, sans réseau et sans clé — c'est ce qui permet d'éprouver
# la BOUCLE en la faisant tourner plutôt qu'en relisant son code. Artefact
# reconstruit à chaque checkpoint, jamais un livrable.
.eval-out/
.eval-tsconfig.json

# Runtime ONNX du mot de reveil : 41 Mio regeneres depuis node_modules par
# scripts/sync-wakeword-runtime.mjs (postinstall). Les MODELES .onnx, eux,
# sont suivis : ce sont des choix de produit, pas une dependance.
public/wakeword/ort/

# Sortie compilee du processus principal/preload Electron (pnpm build:electron)
# — regeneree depuis electron/*.ts, jamais un livrable source.
dist-electron/

# Empaquetage bureau (Electron, etape 9). Deux artefacts RECONSTRUITS, jamais
# des sources :
#   · `resources/serveur/` est assemble par `scripts/preparer-paquet.mjs` a
#     partir de la sortie autonome de Next — une COPIE de fichiers deja
#     versionnes ailleurs ;
#   · `resources/pgsql/` recoit ~200 Mio de binaires PostgreSQL telecharges
#     chez l'editeur. Son README, lui, est suivi : c'est la procedure.
resources/serveur/
resources/pgsql/*
!resources/pgsql/README.md
