    {"id":"pnpm_sharp_disabled","label":"sharp postinstall disabled","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\pnpm-workspace.yaml","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"sharp is an optional Next.js image-optimization dependency unused in Phase 1 (no shipped images); its postinstall is refused to reduce attack surface on the machine that also hosts the clinical database."}
