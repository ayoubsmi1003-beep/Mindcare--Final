    {"id":"pnpm_workspace","label":"pnpm-workspace.yaml","file_type":"code","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\pnpm-workspace.yaml","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},

    {"id":"concept_one_exit_door","label":"One exit door (_shared/external-call.ts)","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"All outbound network calls must go through one gateway file so patient-identifying data can be pseudonymized before leaving the machine; CI and preflight scripts grep for stray fetch() calls."},
    {"id":"concept_jarvis_propose_confirm","label":"Jarvis proposes, human confirms","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Every AI-triggered write shows a confirmation card; state='executed' without confirmed_at is a DB constraint violation by design, preventing silent automated writes on real medical records."},
    {"id":"concept_signed_note_immutability","label":"Signed note immutability (15-min draft window)","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"After a 15-minute draft window a trigger locks the note; corrections must be amendments, never bypassed, so a signed clinical note keeps legal/medical evidentiary value."},
    {"id":"concept_rls_in_database","label":"Security lives in the database (RLS)","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Permissions must be enforced via Postgres RLS with FORCE ROW LEVEL SECURITY, never filtered in JavaScript, because a JS role check can leak clinical data to the wrong role."},
    {"id":"concept_reason_column_trap","label":"appointments_admin view trap (RLS filters rows not columns)","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The assistant front-end must query the appointments_admin view, never the appointments table directly, because RLS row policies cannot hide a single sensitive column like reason."},
    {"id":"concept_forbidden_jarvis_tools","label":"Forbidden Jarvis tool list","file_type":"concept","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"concept_clinical_language_rules","label":"Clinical language rules (describe, never conclude)","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Jarvis must phrase clinical observations descriptively (e.g. 'symptomatology suggesting...') rather than diagnostic conclusions, to avoid biasing or overstepping the practitioner's medical judgment and liability."},
    {"id":"concept_everything_degrades","label":"Everything degrades gracefully","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"If the AI/API is down, the app must remain fully usable for consultation, notes, and certificates, since Jarvis is an accelerator, never a dependency."},

    {"id":"adr_019_app_gatekeeper","label":"ADR-019 app_gatekeeper role","file_type":"concept","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\STATE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"s5_milestone","label":"S5 milestone — session mode, SOAP editor, signature","file_type":"concept","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\STATE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"s5_flaw_consultations_check","label":"S5 flaw: consultations_clinical WITH CHECK missing patient_id","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\STATE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"start_consultation accepted a NULL appointment with a free patient_id; the WITH CHECK on consultations_clinical (007) only constrains practitioner_id, so a practitioner could open a session and write a note on a colleague's patient. Fixed by making the appointment mandatory, since it proves record ownership (SELECT on app.patients is revoked from authenticated since migration 017)."},
    {"id":"s6_milestone_jarvis_text","label":"S6 milestone — Jarvis text + session analysis","file_type":"concept","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\STATE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"lesson_overclaiming_comments","label":"Lesson: comments that over-declare a guarantee block review","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\STATE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A comment claiming a control holds when it doesn't is worse than silence — it stops the next reviewer from looking. A comment declaring a guarantee must name the mechanism, seen repeatedly across S4/S5 defects (grid hiding sessions, password printed in error path)."},
    {"id":"lesson_checkpoint_false_red","label":"Lesson: checkpoint measurement traps (false reds)","file_type":"rationale","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\STATE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A write made by a function called inside a statement isn't visible to the enclosing SELECT/CTE (same snapshot); and a checkpoint depending on ambient state (one_open_consult) can fail from leftover test sessions. Both looked like code defects but were measurement artifacts — a false red sends you to fix what already works."},

    {"id":"checkpoint_j1a","label":"checkpoint-j1a.sh script","file_type":"concept","source_file":"C:\\Users\\ABC Informatique\\.claude\\projects\\Final Mindcare\\.claude\\agents\\db_migrator.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
