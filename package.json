{
  "name": "mindcare-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/garde-origine.mjs && node scripts/verifier-base.mjs && next dev",
    "build": "next build",
    "start": "node scripts/garde-origine.mjs && node scripts/verifier-base.mjs && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "postinstall": "node scripts/sync-wakeword-runtime.mjs",
