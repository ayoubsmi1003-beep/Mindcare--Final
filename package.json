{
  "name": "mindcare-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Logiciel de gestion du cabinet de psychiatrie — dossiers, agenda, consultations, documents, comptabilite.",
  "author": "Cabinet MindCare",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "node scripts/garde-origine.mjs && node scripts/verifier-base.mjs && next dev",
    "build": "next build",
    "start": "node scripts/garde-origine.mjs && node scripts/verifier-base.mjs && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "postinstall": "node scripts/sync-wakeword-runtime.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:jarvis": "bash scripts/checkpoint-jarvis-couche.sh",
    "eval:golden": "node scripts/eval-golden.mjs",
    "eval:replay": "node scripts/replay-golden.mjs",
    "import:medicaments": "node scripts/import-medicaments.mjs --file docs/Médicaments.xlsx",
    "build:electron": "tsc -p electron/tsconfig.json",
    "dev:electron": "pnpm build:electron && node scripts/dev-electron.mjs",
    "icone:generer": "node scripts/generer-icone.mjs",
    "build:desktop": "node scripts/preparer-paquet.mjs && node scripts/elaguer-pgsql.mjs && pnpm build:electron && electron-builder --win && node scripts/verifier-paquet.mjs",
    "pgsql:elaguer": "node scripts/elaguer-pgsql.mjs",
    "verifier:paquet": "node scripts/verifier-paquet.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "next": "^15.1.0",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "^1.29.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "^15.1.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
