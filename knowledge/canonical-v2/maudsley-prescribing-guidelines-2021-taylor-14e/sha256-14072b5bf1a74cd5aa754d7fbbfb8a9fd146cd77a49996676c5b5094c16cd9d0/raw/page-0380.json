        166.8203887939453,
        214.9506072998047,
        185.525390625
      ],
      "text_sha256": "27a1d0aa31b8aa7afa58b5a0c90b7949fed87e7c097e45d123da5b305ed9da67"
    },
    {
      "block_id": "page-0380-block-0009",
      "order": 9,
      "text": "RCT shows benefit \nfor combination from \nthird day of treatment\n",
      "bbox": [
