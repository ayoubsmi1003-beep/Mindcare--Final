        340.58795166015625
      ],
      "text_sha256": "59919d5abd99f62d35bef8a748b59fb96d6ed786edc7915ffcc3a3abcec36a75"
    },
    {
      "block_id": "page-0380-block-0014",
      "order": 14,
      "text": "Methylphenidate 1.25–20mg a \nday51–53\n",
      "bbox": [
        118.49940490722656,
        291.8829650878906,
        219.77938842773438,
        310.58795166015625
      ],
      "text_sha256": "3446f229b6209e54ef1caf0b73dfbecb914081e1980f306aa1072a9833871fcb"
    },
    {
      "block_id": "page-0380-block-0015",
      "order": 15,
      "text": "Use supported by \nthree placebo-\ncontrolled studies. \nRapid effect observed \non mood and activity\n",
      "bbox": [
        232.49940490722656,
        291.90301513671875,
        303.62188720703125,
        340.6004943847656
      ],
      "text_sha256": "625cd8fb5275fb0aece29f472e8fb5d883346168b41604eca947c0c27ce62dc6"
    },
    {
      "block_id": "page-0380-block-0016",
      "order": 16,
      "text": "Recommended only where \npatients fail to tolerate standard \nantidepressants or where \ncontra-indications apply.\n",
      "bbox": [
        307.8594055175781,
        291.8955078125,
        412.3119812011719,
        330.5954895019531
      ],
      "text_sha256": "ae00ac7de48dab14d14d84c3bc98fc30e55f048c15b867e54ec7752974e56696"
    },
    {
      "block_id": "page-0380-block-0017",
      "order": 17,
      "text": "Methylphenidate \n5–40mg + citalopram \n20–60mg/day54\n",
      "bbox": [
        118.49940490722656,
        346.9154968261719,
        189.6743927001953,
        375.61798095703125
      ],
      "text_sha256": "6d780227ba3e5e942ea8ebaff661eec62bbf95bccbe0691ca8bc0d378b10b626"
    },
    {
      "block_id": "page-0380-block-0018",
      "order": 18,
      "text": "One placebo-\ncontrolled study. \nFaster rate of response \nwith combination \ncompared to \nmonotherapy with \neither drug\n",
      "bbox": [
        232.49940490722656,
        346.9280090332031,
        303.9368591308594,
        415.6204833984375
      ],
      "text_sha256": "80850f851e59e085281b841d62ffc086c2339b51d0b32d976c6c50a6d424675a"
    },
    {
      "block_id": "page-0380-block-0019",
      "order": 19,
      "text": "Monitor for increased heart rate \n– significant increase seen in one \ntrial.54\n",
      "bbox": [
        307.8594055175781,
        346.9129943847656,
        414.8244934082031,
        375.615478515625
      ],
      "text_sha256": "f2c3938623c8e7952178651d0ce259557bc2982f82df880a092d760bf3810a06"
    },
    {
      "block_id": "page-0380-block-0020",
      "order": 20,
      "text": "Monotherapy in \npost-stroke \ndepression\n",
      "bbox": [
        48.0,
        421.7729797363281,
        107.17498779296875,
        450.6554870605469
      ],
      "text_sha256": "92a3549a2b41c8b35a8279058a50377630cc7ede3f32b2f0056a637099af36e9"
    },
    {
      "block_id": "page-0380-block-0021",
      "order": 21,
      "text": "Methylphenidate 5–40mg a \nday55–58\n",
      "bbox": [
        118.5,
        421.94549560546875,
