        440.6504821777344
      ],
      "text_sha256": "670b8aa436fa469e698febf78c0af76fc1a7158c0bb4ed07aec3276c7820df19"
    },
    {
      "block_id": "page-0380-block-0022",
      "order": 22,
      "text": "Variable support but \nincluding two \nplacebo-controlled \ntrials.55,58 Effect on \nmood evident after a \nfew days\n",
      "bbox": [
        232.4963836669922,
        421.9530029296875,
        301.6688537597656,
        480.6554870605469
      ],
      "text_sha256": "72a0628a12588563d0aafe3dab39e2fe7c4cd44623df7df8c9edcf1e4a5e42cd"
    },
    {
      "block_id": "page-0380-block-0023",
      "order": 23,
      "text": "Standard antidepressants \npreferred. Further investigation \nrequired: stimulants may improve \ncognition and motor function.\n",
      "bbox": [
        307.85638427734375,
        421.94549560546875,
        416.201416015625,
        460.6454772949219
      ],
      "text_sha256": "cfeecca560ebeed077b161697a46ea1ebec1b649584f6d700ce53be4db12cbb2"
    },
    {
      "block_id": "page-0380-block-0024",
