      ],
      "text_sha256": "e52efb1249ed152d91c0cfa2b5b91b3a01def8f0d4be8c5cf20b2084547bbfa4"
    },
    {
      "block_id": "page-0380-block-0012",
      "order": 12,
      "text": "Modafinil 200mg/day50\nBenefit to depression \nscores only in those \nalso experiencing \nsevere cancer-related \nfatigue\n",
      "bbox": [
        118.49940490722656,
        236.87046813964844,
