        195.53045654296875
      ],
      "text_sha256": "212c752837911bdc166049cca8f24424646481d9013be41eb48fe015aad81ac1"
    },
    {
      "block_id": "page-0380-block-0010",
      "order": 10,
      "text": "Methylphenidate 20mg/\nday + SSRI49\n",
      "bbox": [
        118.49940490722656,
        201.84544372558594,
        195.59938049316406,
        220.55044555664062
      ],
      "text_sha256": "97107467af7a065e43a8e7b9950d1a1d86acbd78cd3f2cc7fa13d11ce2405a78"
    },
    {
      "block_id": "page-0380-block-0011",
      "order": 11,
      "text": "RCT failed to show \nbenefit for \ncombination\n",
      "bbox": [
