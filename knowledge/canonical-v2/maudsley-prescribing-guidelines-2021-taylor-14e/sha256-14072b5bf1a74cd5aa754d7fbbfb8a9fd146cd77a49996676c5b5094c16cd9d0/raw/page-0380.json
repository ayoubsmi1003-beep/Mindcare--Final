      ],
      "text_sha256": "fca3b7dee0c0b9a04e865388786f498ecb6134042d11736e07bed0b936337c7c"
    },
    {
      "block_id": "page-0380-block-0013",
      "order": 13,
      "text": "Monotherapy  \nor add-on \ntreatment for \ndepression in \nthe elderly\n",
