    },
    {
      "block_id": "page-0223-block-0015",
      "order": 15,
      "text": "Amisulpride + olanzapine\nQuetiapine + amisulpride\nAripiprazole + olanzapine\n",
      "bbox": [
        135.38914489746094,
        322.65435791015625,
