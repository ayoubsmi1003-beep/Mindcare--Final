      "text_sha256": "f671189707a6d6d4f5c378aa0c135d54dd7ac2e330b2f1ddf6138dde9a851dea"
    },
    {
      "block_id": "page-0223-block-0016",
      "order": 16,
      "text": "Polypharmacy is common in \nclinical practice. Evidence from \ncontrolled studies limited but \nopen studies and real-world data \nsuggest some effectiveness. \nBurden of adverse effects is \nincreased\n",
      "bbox": [
        231.71913146972656,
        322.6468505859375,
        339.1117248535156,
        391.3393249511719
