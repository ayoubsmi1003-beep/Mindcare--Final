    {
      "block_id": "page-0223-block-0012",
      "order": 12,
      "text": "Evidence of efficacy for any \nantipsychotic other than clozapine \nin refractory schizophrenia is \nsparse. Some data suggest \nefficacy for olanzapine above \nlicensed doses but at the risk of \nmetabolic adverse effects\n",
      "bbox": [
        231.71913146972656,
        247.6543731689453,
        343.3941955566406,
        316.34686279296875
      ],
      "text_sha256": "b231b158a04ab08549f1d5301c44e08d45f5d4ddca38006b0ad38d3cf0defde2"
    },
    {
      "block_id": "page-0223-block-0013",
