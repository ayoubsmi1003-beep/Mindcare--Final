        422.2254943847656
      ],
      "text_sha256": "0c6b7393009f26c31f1a4ae2c3efd52309ccac73505f8372476eb6c2e54a9aab"
    },
    {
      "block_id": "page-0844-block-0026",
      "order": 26,
      "text": "Drug\nSpecific evidence and considerations\n",
      "bbox": [
        52.0,
        432.072998046875,
        240.76756286621094,
        440.96051025390625
      ],
      "text_sha256": "2a071ca2cafd8ec2c50998784776148f60524242b4f9b89a8c95586a89da6381"
    },
    {
      "block_id": "page-0844-block-0027",
      "order": 27,
      "text": "Asenapine20\n■\n■Primarily absorbed via oral mucosa; problems after bariatric surgery are not expected\n",
      "bbox": [
        52.0,
        449.697998046875,
        391.1424560546875,
        458.58551025390625
      ],
      "text_sha256": "fa20b4598f137bab8177a995707ed9eb69e21c6c31eb8a3d559836d3f86874da"
    },
    {
      "block_id": "page-0844-block-0028",
      "order": 28,
      "text": "■\n■One case report of successful use after RYGB\n",
      "bbox": [
        111.9999008178711,
        459.8780212402344,
        264.52752685546875,
        468.58551025390625
      ],
      "text_sha256": "cac3bda6dbf7de1a15d96046118e5fa9943f9f8e56e86ef65f9e7a855d577ac4"
    },
    {
      "block_id": "page-0844-block-0029",
      "order": 29,
      "text": "Cariprazine\n■\n■No data available on absorption after bariatric surgery; follow general recommendations.\n",
      "bbox": [
        52.0,
        477.322998046875,
        404.6425476074219,
        486.21051025390625
      ],
      "text_sha256": "8f01de0f9188194ef0498a3920f5659f862733354b99a3a3ccb68a781a4c7e14"
    },
    {
      "block_id": "page-0844-block-0030",
      "order": 30,
      "text": "Clozapine21–23\n■\n■Two case reports of relapse after RYGB24\n",
      "bbox": [
        52.0,
        494.947998046875,
        249.7613067626953,
        503.83551025390625
      ],
      "text_sha256": "3e6874ecca09d629eada131a23db3c89f36b0e66fd4c5d307b95f92337b8edae"
    },
    {
      "block_id": "page-0844-block-0031",
      "order": 31,
      "text": "■\n■Take drug plasma levels before surgery and regularly monitor after\n",
      "bbox": [
        111.9999008178711,
        505.1280212402344,
        332.4100341796875,
        513.8355102539062
      ],
      "text_sha256": "1063469879812995f7c8b07e63b1c1338d5a3eee023d561d58b28dc03ef93721"
    },
    {
      "block_id": "page-0844-block-0032",
      "order": 32,
      "text": "■\n■Constipation is common after surgery; the manufacturer recommends close monitoring and \n",
      "bbox": [
        111.9999008178711,
        515.1279907226562,
        416.17755126953125,
        523.8355102539062
      ],
      "text_sha256": "3f21eb2357d17240b094025cf1a5d6ae5be8b1467a502e8927055f95168b0e23"
    },
    {
      "block_id": "page-0844-block-0033",
      "order": 33,
      "text": "active treatment\n",
      "bbox": [
        121.0,
        525.12548828125,
        172.92999267578125,
        533.8330078125
      ],
      "text_sha256": "05606ee744d7d8089740fbdf0a1c3fe305bc37ad40641e6ecc5b620453e9639e"
    },
    {
      "block_id": "page-0844-block-0034",
      "order": 34,
      "text": "■\n■Check smoking status (quitting before surgery is encouraged); adjust dose accordingly\n",
      "bbox": [
        111.9999008178711,
        535.1279907226562,
        395.7850646972656,
        543.8355102539062
      ],
      "text_sha256": "302d19fdeefe00f52154b97ed2252c0d44f4d067c87cb49a5ce71c6d74cff514"
    },
    {
      "block_id": "page-0844-block-0035",
      "order": 35,
      "text": "Haloperidol25\n■\n■Single case report suggests levels after RYGB are similar to those generally reported in the \n",
      "bbox": [
        52.0,
        552.572998046875,
        409.27008056640625,
        561.4605102539062
      ],
      "text_sha256": "e82024107f0a24773cbac830812269f297dd92cca3fec3f1278a77db47709b00"
    },
    {
      "block_id": "page-0844-block-0036",
      "order": 36,
      "text": "literature\n",
      "bbox": [
        121.0,
        562.75048828125,
        149.60499572753906,
        571.4580078125
      ],
      "text_sha256": "188f342fb0a0230609070289a53b42484ba2d8767c0d2f77fd95bb290eae14f2"
    },
    {
