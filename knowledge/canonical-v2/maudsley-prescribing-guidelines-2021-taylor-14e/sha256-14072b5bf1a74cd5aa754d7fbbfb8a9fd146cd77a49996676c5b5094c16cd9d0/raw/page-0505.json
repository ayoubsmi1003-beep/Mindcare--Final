      "text_sha256": "3ec1fc2e992357fa6a20faf350e6de277958f4a1f8256056cba5ad0ca144eb64"
    },
    {
      "block_id": "page-0505-block-0029",
      "order": 29,
      "text": "■\n■It alleviates/prevents opioid withdrawal and craving.\n",
      "bbox": [
