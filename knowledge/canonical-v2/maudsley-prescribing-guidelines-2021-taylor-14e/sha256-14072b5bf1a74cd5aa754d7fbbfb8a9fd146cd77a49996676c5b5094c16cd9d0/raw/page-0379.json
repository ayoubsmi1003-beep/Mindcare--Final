        405.77960205078125,
        486.13287353515625
      ],
      "text_sha256": "6fde5c048ea9a2dc668ac102ac4e3e50277f257e1ae3819c6f4d01d969e6fb42"
    },
    {
      "block_id": "page-0379-block-0024",
      "order": 24,
      "text": "Mood stabiliser + armodafinil \n150–200mg/day38\nSuperior to placebo \non some measures\n",
      "bbox": [
        132.38929748535156,
        442.4529113769531,
        310.9868469238281,
        461.15789794921875
      ],
      "text_sha256": "f4dc1142957c802c2fa1dca1492669f955867d12ad7d5c188b49961c23dfd40c"
    },
    {
      "block_id": "page-0379-block-0025",
      "order": 25,
      "text": "Mood \nstabiliser + methylphenidate \n10–40mgday39\n",
      "bbox": [
        132.38929748535156,
        467.472900390625,
        224.39175415039062,
        496.1753845214844
      ],
      "text_sha256": "ef19a88098e172a715c033e9c88f8c7714b82a5d1f58bbe20f24db1afeee85b7"
    },
    {
      "block_id": "page-0379-block-0026",
      "order": 26,
      "text": "Mixed results, mainly \npositive\n",
      "bbox": [
