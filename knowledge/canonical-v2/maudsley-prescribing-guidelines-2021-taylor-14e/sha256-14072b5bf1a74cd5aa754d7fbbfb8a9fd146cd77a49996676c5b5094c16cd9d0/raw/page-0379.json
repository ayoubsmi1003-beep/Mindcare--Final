    {
      "block_id": "page-0379-block-0004",
      "order": 4,
      "text": "Adjunctive \ntreatment of \ndepression with \nfatigue and \nhypersomnia\n",
      "bbox": [
        61.8900146484375,
        107.09541320800781,
