        240.62925720214844,
        531.2053833007812
      ],
      "text_sha256": "3e1996cd0cc1608de25e89b74e5eec1251a26a256698f5133b7e789c3e92fcee"
    },
    {
      "block_id": "page-0379-block-0028",
