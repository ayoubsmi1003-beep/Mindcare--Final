    {
      "block_id": "page-0635-block-0053",
      "order": 53,
      "text": "None known\nAntagonistic effects with anticholinergic and competitive neuromuscular blockers (e.g. \n",
      "bbox": [
        321.9898681640625,
        79.2408676147461,
        330.87738037109375,
        454.2559814453125
      ],
