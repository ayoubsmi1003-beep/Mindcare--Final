    },
    {
      "block_id": "page-0635-block-0054",
      "order": 54,
      "text": "tubocurarine). Potential for synergistic activity with cholinomimetics such as depolarising \n",
      "bbox": [
        331.98736572265625,
        76.09090423583984,
        340.8748779296875,
        375.25848388671875
      ],
