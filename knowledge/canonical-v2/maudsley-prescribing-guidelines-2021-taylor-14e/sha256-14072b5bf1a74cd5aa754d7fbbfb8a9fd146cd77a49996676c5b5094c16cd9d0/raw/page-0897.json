      "text_sha256": "5759cae9913207572a5d82f4b046f3ad04560ec2edca61ab0b7ab2501e6c4f85"
    },
    {
      "block_id": "page-0897-block-0016",
      "order": 16,
      "text": "Sedation, coma, hypotension, \nhypertension, tachycardia, possible QT \nprolongation.\n",
