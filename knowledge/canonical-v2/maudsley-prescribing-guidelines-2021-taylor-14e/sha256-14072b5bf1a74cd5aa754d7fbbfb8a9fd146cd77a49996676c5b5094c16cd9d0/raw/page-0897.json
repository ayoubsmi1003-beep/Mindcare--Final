      "text_sha256": "04da8b2a930a2fd5778671d956ce2fb89588d66f2ddf3982d55e896444c7a477"
    },
    {
      "block_id": "page-0897-block-0014",
      "order": 14,
      "text": "Tremor, weakness, confusion, sweating, \ntachycardia, hypertension.\n",
      "bbox": [
        293.8872985839844,
