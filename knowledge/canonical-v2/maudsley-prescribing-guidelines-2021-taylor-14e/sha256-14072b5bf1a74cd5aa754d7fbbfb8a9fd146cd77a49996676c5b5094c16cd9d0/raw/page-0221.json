      ],
      "text_sha256": "52bdc65cf96665369099dbd2d0da13138208d3e892e3618d299a3594781cc3bf"
    },
    {
      "block_id": "page-0221-block-0030",
      "order": 30,
      "text": "Some evidence that this combination improves mood symptoms\n",
      "bbox": [
        177.8914031982422,
        457.34442138671875,
        382.3565368652344,
        466.0519104003906
      ],
      "text_sha256": "a821869a46734ffea02e848b40d86280c193030543df5de4531ef0acb7e62fb3"
    },
    {
      "block_id": "page-0221-block-0031",
      "order": 31,
      "text": "Omega-3-triglycerides72,73\nSuggested efficacy but data very limited\n",
      "bbox": [
        61.88890075683594,
        492.18939208984375,
        305.2463684082031,
        501.076904296875
      ],
      "text_sha256": "327221137683a779dfdbe092d4aef8c253d41107f0f7455cd7140427e1417f6f"
    },
    {
      "block_id": "page-0221-block-0032",
