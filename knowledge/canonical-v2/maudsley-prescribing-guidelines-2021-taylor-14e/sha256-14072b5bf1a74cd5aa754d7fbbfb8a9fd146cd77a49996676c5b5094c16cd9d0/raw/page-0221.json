      "block_id": "page-0221-block-0020",
      "order": 20,
      "text": "(0.8g/kg/day)\n",
      "bbox": [
        61.88890075683594,
        362.2669372558594,
        103.99388885498047,
        370.97442626953125
      ],
      "text_sha256": "618ff2cc712c007b0778d607bff150816c61d724e717e6c236ed964c8da34335"
    },
    {
      "block_id": "page-0221-block-0021",
      "order": 21,
      "text": "Small, double-blind crossover trial suggests clinically relevant improvement in \nnegative symptoms\n",
      "bbox": [
        177.8914031982422,
        352.2694396972656,
        424.9865417480469,
        370.97442626953125
      ],
      "text_sha256": "a1a928220ed82df63df7ad69802e8c5662708fce9f3c9cd5033851d1d772fce6"
    },
    {
      "block_id": "page-0221-block-0022",
      "order": 22,
      "text": "Olanzapine + lamotrigine65,69\n",
      "bbox": [
        61.88890075683594,
        387.1144104003906,
        162.35568237304688,
        396.0019226074219
      ],
      "text_sha256": "3bed0544214a72082ebb27ad0ada0a06333d51bd6f579ef9fac49b4760123f59"
    },
    {
      "block_id": "page-0221-block-0023",
      "order": 23,
      "text": "(up to 400mg/day)\n",
      "bbox": [
        61.88890075683594,
