        353.0044250488281,
        559.5971069335938
      ],
      "text_sha256": "88ad0d64d910b953b715e6cc30c62b6fdb9ec3b4b6ee39a417c617e7d597f6ad"
    },
    {
      "block_id": "page-0950-block-0029",
      "order": 29,
      "text": "or\n",
      "bbox": [
