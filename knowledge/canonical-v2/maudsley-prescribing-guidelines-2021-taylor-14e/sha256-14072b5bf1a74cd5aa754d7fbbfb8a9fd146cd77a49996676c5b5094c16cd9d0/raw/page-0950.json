    },
    {
      "block_id": "page-0950-block-0017",
      "order": 17,
      "text": "■\n■people must be assumed to have capacity unless it is established that they lack \n",
      "bbox": [
        48.03929901123047,
        400.8770751953125,
        422.8042907714844,
        412.5970764160156
      ],
      "text_sha256": "1f75cd98cd1e84510c7935ef4bc852d77dca09f90bb624d0683b8cbb102e7f56"
    },
    {
