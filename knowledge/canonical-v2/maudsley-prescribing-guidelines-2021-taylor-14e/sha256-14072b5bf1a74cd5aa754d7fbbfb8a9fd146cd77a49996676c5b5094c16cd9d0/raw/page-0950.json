      "order": 27,
      "text": "or\n",
      "bbox": [
        56.844398498535156,
        535.8770751953125,
        66.29440307617188,
        547.5971069335938
      ],
      "text_sha256": "a1c74ae37f82d3ee9b65439846c1ae28413a6070182ce475293aefa165d2b65f"
    },
    {
      "block_id": "page-0950-block-0028",
      "order": 28,
      "text": "■\n■use or weigh that information as part of the decision making process\n",
      "bbox": [
        48.03929901123047,
