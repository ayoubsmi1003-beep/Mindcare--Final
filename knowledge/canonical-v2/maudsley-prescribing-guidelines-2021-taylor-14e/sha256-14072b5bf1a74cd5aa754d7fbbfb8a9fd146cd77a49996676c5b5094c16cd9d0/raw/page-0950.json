        242.06707763671875
      ],
      "text_sha256": "782803f2b56e1034163beeb3be660ca1edc3eadd8108f4e9e88925d8fc4eafd6"
    },
    {
      "block_id": "page-0950-block-0012",
      "order": 12,
      "text": "The Code of 24.34 defines consent as:\n",
      "bbox": [
        48.039398193359375,
