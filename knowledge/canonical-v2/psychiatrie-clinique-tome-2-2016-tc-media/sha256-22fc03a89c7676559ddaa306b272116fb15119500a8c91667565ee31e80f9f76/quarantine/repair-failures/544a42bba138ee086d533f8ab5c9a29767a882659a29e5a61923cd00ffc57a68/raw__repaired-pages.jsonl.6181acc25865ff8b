345.7744140625,551.4800415039062,355.6181640625],"block_index":12,"block_no":12,"block_type":0,"text":"80.4 Indications et contre-indications.............................. 1721\n","text_sha256":"fd50026e687670849a5c1327d828f214d15d465d0c69589c7cd9180f6f3e0485"},{"bbox":[310.5,359.7744140625,551.4800415039062,369.6181640625],"block_index":13,"block_no":13,"block_type":0,"text":"80.5 Résultats selon les données probantes ..................... 1722\n","text_sha256":"32f67dd669907dffd74bac552e0bc0f99ed872f97c663a147102b2fb38e8d7e2"},{"bbox":[310.5,373.7744140625,551.4800415039062,383.6181640625],"block_index":14,"block_no":14,"block_type":0,"text":"Lectures complémentaires.................................................... 1723\n","text_sha256":"08c9a3ba24ef2e4c2904c44dc49da94119dac59168e29090ce666c9d25328f31"}],"extraction_status":"auto_ok","page_height":783.0,"page_width":603.0,"parser":"pymupdf-1.28.2","raw_sha256":"00fb7ae2c83a2c72d1c09520bc198148e04adce144dff5f75ccf234a43b87314","raw_text":"CHAPITRE80\nThérapie motivationnelle\nFlorence Chanut, M.D., FRCPC\nPsychiatre, Service des maladies aectives, Hôpital\ndu Sacré-Cœur de Montréal\nProfesseure adjointe de clinique, Département de psychiatrie,\nFaculté de médecine, Université de Montréal\nMembre du Motivational Interviewing Network of Trainers\net de l’Association francophone de diusion de l’entretien\nmotivationnel\nStéphane Proulx, M.D., FRCPC\nPsychiatre, Service des urgences psychiatriques, Hôpital\nMaisonneuve-Rosemont (Montréal)\nProfesseur adjoint de clinique, Département de psychiatrie,\nFaculté de médecine, Université de Montréal\n80.1 Historique et bases théoriques...................................1708\n80.1.1 Précurseurs de la thérapie motivationnelle ...1708\n80.1.2 Modèle transthéorique du changement ........1709\n80.1.3 Évolution de la thérapie motivationnelle .......1711\n80.2 Formation des thérapeutes .........................................1712\n80.3 Principes et modalités d’application ....