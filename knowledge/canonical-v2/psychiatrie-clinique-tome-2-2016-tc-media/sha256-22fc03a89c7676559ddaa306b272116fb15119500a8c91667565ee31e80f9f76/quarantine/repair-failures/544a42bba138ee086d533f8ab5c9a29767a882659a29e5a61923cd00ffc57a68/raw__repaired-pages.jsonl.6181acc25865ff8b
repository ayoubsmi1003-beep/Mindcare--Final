requis par son état de santé.\n","repair_count":0,"repair_references":["repair:115:757:unresolved-u+e00e","repair:115:867:unresolved-u+e00c","repair:115:1231:unresolved-u+e00c","repair:115:1250:unresolved-u+e00c","repair:115:1338:unresolved-u+e00c","repair:115:1743:unresolved-u+e00c","repair:115:1951:unresolved-u+e00c","repair:115:2092:unresolved-u+e00c","repair:115:2196:unresolved-u+e00c","repair:115:2301:unresolved-u+e00c","repair:115:2355:unresolved-u+e00c","repair:115:2931:unresolved-u+e00c","repair:115:2983:unresolved-u+e00e","repair:115:3166:unresolved-u+e00a","repair:115:3371:unresolved-u+e00c","repair:115:3759:unresolved-u+e00e","repair:115:3866:unresolved-u+e00a","repair:115:4430:unresolved-u+e00c","repair:115:4746:unresolved-u+e00a","repair:115:5431:unresolved-u+e00a","repair:115:6258:unresolved-u+e015","repair:115:6259:unresolved-u+e02d","repair:115:6729:unresolved-u+e00a"],"source_page_display":116,"source_page_index":115,"unresolved_count":23}
