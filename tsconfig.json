{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.cts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // S6 — code Deno (supabase/functions/), incompatible avec ce projet TS :
    // `Deno` global et spécificateurs `npm:...` n'existent pas sous
    // `moduleResolution: "bundler"`. Décision actée avec l'utilisateur (plan
    // S6 approuvé §2, STATE.md) : ni `pnpm typecheck` ni `pnpm build` ne
    // couvrent ce code, au même titre que les portes 026 sans Docker
    // joignable — un blocage déjà connu, pas un nouveau. La relecture
    // manuelle en tient lieu jusqu'à ce que `deno check` soit disponible.
    "supabase/functions",
    // Les tests unitaires ont leur propre configuration (`tsconfig.test.json`)
    // parce qu'eux SEULS importent le code Deno de `supabase/functions/`, avec
    // l'extension `.ts` que Deno impose. Les vérifier ici obligerait à poser
    // `allowImportingTsExtensions` sur toute l'application, pour le besoin de
    // deux fichiers. `pnpm typecheck` lance les deux configurations.
    "tests"
  ]
}
