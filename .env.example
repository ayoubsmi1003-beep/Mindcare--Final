# MindCare OS — variables d'environnement (client)
# Seules les variables NEXT_PUBLIC_* atteignent le navigateur (I1).
# Ne jamais ajouter SERVICE_ROLE_KEY, GROQ_API_KEY ou OPENROUTER_API_KEY ici :
# ces secrets vivent uniquement côté serveur, hors de src/.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
